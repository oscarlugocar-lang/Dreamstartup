{
  "name": "dreamscape-api",
  "version": "1.0.0",
  "description": "Dreamscape Agency API",
  "main": "api/server.js",
  "scripts": {
    "start": "npx prisma db push --accept-data-loss && node prisma/seed.js && node api/server.js",
    "dev": "nodemon api/server.js",
    "test": "jest tests/ --verbose",
    "test:watch": "jest tests/ --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "openai": "^6.44.0",
    "stripe": "^22.2.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.14.0",
    "supertest": "^6.3.3"
  }
}
